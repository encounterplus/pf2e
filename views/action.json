{
  "spacing": 8,
  "padding": [20],
  "footer": true,
  "views": [
    {
      "type": "hStack",
      "alignment": "bottom",
      "views": [
        { "value": "{{name|uppercase}}", "style": "stats-title" },
        { "value": "ACTION", "alignment": "trailing", "style": "stats-title", "width": -1 }
      ]
    },
    { "type": "divider", "bgColor": "#000000", "height": 1.5, "padding": [0] },
    { "type": "tags", "attribute": "data.traits" },
    { "type": "text", "value": "{{descr}}", "style": "stats-body" },
    { "type": "text", "title": "Common.Notes", "value": "{{notes}}" },
    { "type": "text", "value": "{% if data.sourceName %}**{{'Common.Source'|l}}:** {{data.sourceName}}{% else %}{{footer}}{% endif %}" },
    { "type": "tags", "attribute": "tags" }
  ]
}
