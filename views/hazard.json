{
  "spacing": 8,
  "padding": [20],
  "footer": true,
  "views": [
    {
      "type": "hStack",
      "alignment": "bottom",
      "views": [
        { "value": "{{name|uppercase}}", "style": "stats-title" },
        { "value": "HAZARD {{data.level|default: '0'}}", "alignment": "trailing", "style": "stats-title", "width": -1 }
      ]
    },
    { "type": "divider", "bgColor": "#000000", "height": 1.5, "padding": [0] },
    { "type": "flow", "spacing": 0, "views": [
      { "type": "label", "value": "{{data.rarity|map: 'Rarity'}}", "style": "trait", "bgColor": "#8F5441", "padding": [4, 8], "borderColor": "#d8c384", "borderWidth": 2, "visibleIf": "data.rarity != '' and data.rarity != 'common'", "link": "/trait/{{data.rarity|map: 'Rarity'}}" },
      { "type": "list", "attribute": "data.traitLinks", "visibleIf": "data.traitLinks != nil", "views": [
        { "type": "label", "value": "{{label}}", "style": "trait", "bgColor": "#58180D", "padding": [4, 8], "borderColor": "#d8c384", "borderWidth": 2, "link": "{% if slug %}/trait/{{slug}}{% endif %}" }
      ] },
      { "type": "list", "attribute": "data.traits", "visibleIf": "data.traitLinks == nil", "views": [
        { "type": "label", "value": "{{self}}", "style": "trait", "bgColor": "#58180D", "padding": [4, 8], "borderColor": "#d8c384", "borderWidth": 2, "link": "/trait/{{self}}" }
      ] }
    ] },
    { "type": "text", "value": "{% include \"hazard-stats.md\" %}", "style": "stats-body" },
    { "type": "text", "value": "{{descr}}", "style": "stats-body" },
    { "type": "text", "title": "Common.Notes", "value": "{{notes}}" },
    { "type": "text", "value": "{% if data.sourceName %}**{{'Common.Source'|l}}:** {{data.sourceName}}{% else %}{{footer}}{% endif %}" },
    { "type": "tags", "attribute": "tags" }
  ]
}
