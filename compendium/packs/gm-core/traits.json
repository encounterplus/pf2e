  {
    "id": "A88BED7F-C67E-59F5-B672-301CCD2E6175",
    "kind": "Trait",
    "system": "pf2e-remaster",
    "systemVersion": "1.2.10",
    "name": "Erratic",
    "slug": "erratic",
    "descr": "Time slows down and speeds up, so an individual might lose or gain time as they move between planes. When a creature moves from a plane with erratic time to one with normal time, roll a DC 11 flat check. Creatures that leave an erratic time plane together share the same result.\n\n**Success** Time passed normally on the erratic time plane.\n**Failure** For each hour spent on the erratic time plane, 1 day passed on the normal time plane.\n**Critical Failure** For each round spent on the erratic time plane, 1 day passed on the normal time plane.",
    "data": {
      "rarity": "common",
      "traits": [],
      "traitLinks": []
    },
    "attributes": {
      "remaster": true,
      "sourceId": "gm-core",
      "license": "ORC-1.0a"
    },
