  {
    "id": "C03B3E27-9948-5DE1-A9C2-E940AAC7FC9B",
    "kind": "Trait",
    "system": "pf2e-remaster",
    "systemVersion": "1.2.10",
    "name": "Impossible",
    "slug": "impossible",
    "descr": "All impossible spells have the impossible trait, which labels them as spells that can be cast only once in a creature's existence. After casting a spell with the impossible trait, the same creature can't cast any spell with the impossible trait ever again. An hour after casting the spell, the caster starts experiencing the consequences detailed under the spell's lethologic mark entry. The entry also includes how the effects of the mark can be healed.\n\n Spells with this trait are also more difficult to [counteract](/rule/counteracting-rules-3280). Any counteract check against the spell gets an outcome one degree of success worse than was rolled, and any effect that would automatically counteract the spell fails.\n\n [Spellshape](/trait/spellshape) effects cannot be applied to impossible spells.\n\nThe full rules for casting impossible spells appear [here](/rule/casting-impossible-spells-impossible-magic-rules-rules-3695)",
    "data": {
      "rarity": "common",
      "traits": [
        "impossible"
      ],
      "traitLinks": [
        {
          "label": "impossible",
          "slug": "impossible"
        }
      ]
    },
    "attributes": {
      "remaster": true,
      "sourceId": "impossible-magic",
      "license": "ORC-1.0a"
    },
    "tags": [
      "impossible",
      "impossible-magic",
      "remaster",
      "trait"
    ],
