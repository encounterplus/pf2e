  {
    "id": "16B024C4-6029-59AD-8943-36B9CC3E95E7",
    "kind": "Trait",
    "system": "pf2e-remaster",
    "systemVersion": "1.2.10",
    "name": "Invocation",
    "slug": "invocation",
    "descr": "An invocation action allows a [runesmith](/class/runesmith-impossible-magic-class-class-76) to surge power through their rune by uttering its true name. Invocation requires you to be able to speak clearly in a strong voice and requires that you be within 30 feet of the target rune or runes unless another ability changes this. These actions include the [Invoke Rune](/action/invoke-rune-impossible-magic-action-action-4265) action, which makes the rune’s invocation take place, then causes the rune to fade away. Using Invoke Rune normally allows you to invoke two runes, but other abilities that include the Invoke Rune action often change that number or the specific runes you can invoke.",
    "data": {
      "rarity": "common",
      "traits": [
        "invocation"
      ],
      "traitLinks": [
