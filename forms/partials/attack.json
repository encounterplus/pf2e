{
  "sections": [
    {
      "type": "group",
      "fields": [
        {
          "placeholder": "Common.Name",
          "attribute": "name"
        },
      ]
    },
    {
      "type": "group",
      "fields": [
        {
          "title": "Common.Type",
          "type": "picker",
          "attribute": "type",
          "attributeType": "Attack",
          "defaultValue": "melee"
        },
        {
          "title": "Common.Actions",
          "type": "picker",
          "attribute": "actions",
          "attributeType": "Action",
          "defaultValue": "one"
        },
        {
          "title": "Common.Traits",
          "type": "tags",
          "attribute": "traits",
          "attributeType": "Trait"
        },
      ]
    },
    {
      "type": "group",
      "fields": [
        {
          "title": "Common.AttackModifier",
          "type": "number",
          "attribute": "attack",
        }
      ]
    },
    {
      "title": "Common.Damage",
      "type": "list",
      "attribute": "damageParts",
      "custom": {
        "itemTitle": "{% if name %}{{name}}{% else %}{% if formula %}{{formula}}{% else %}{{'Common.Damage'|l}}{% endif %}{% endif %}",
        "itemDetail": "{{details}}"
      },
      "form": {
        "title": "Creature.DamageComponent",
        "partial": "damage-part"
      }
    },
    {
      "title": "Common.Effect",
      "type": "list",
      "attribute": "effects",
      "custom": {
        "itemTitle": "{{name}}"
      },
      "form": {
        "title": "Common.Effect",
        "partial": "attack-effect"
      }
    }
  ]
}
