{
  "title": "Item",
  "entity": "Item",
  "sections": [
    {
      "type": "group",
      "fields": [
        {
          "title": "Common.Category",
          "type": "picker",
          "attribute": "data.category",
          "attributeType": "ItemCategory"
        },
        {
          "title": "Common.Level",
          "type": "number",
          "attribute": "data.level"
        },
        {
          "title": "Common.Rarity",
          "type": "picker",
          "attribute": "data.rarity",
          "attributeType": "Rarity"
        },
        {
          "title": "Common.Traits",
          "type": "tags",
          "attribute": "data.traits",
          "attributeType": "Trait"
        },
        {
          "title": "Common.Subcategory",
          "type": "picker",
          "attribute": "data.subcategory",
          "attributeType": "ItemSubcategory"
        }
      ]
    },
    {
      "title": "Item.Equipment",
      "type": "group",
      "fields": [
        {
          "title": "Common.Price",
          "attribute": "data.price"
        },
        {
          "title": "Item.Usage",
          "attribute": "data.usage"
        },
        {
          "title": "Item.Bulk",
          "attribute": "data.bulk"
        },
        {
          "title": "Item.AdditionalDetails",
          "type": "form",
          "text": "{% if data.ammunition or data.onset or data.craftRequirements %}{% if data.ammunition %}{{'Item.Ammunition'|l}}: {{data.ammunition}}{% endif %}{% if data.onset %}{% if data.ammunition %} • {% endif %}{{'Item.Onset'|l}}: {{data.onset}}{% endif %}{% if data.craftRequirements %}{% if data.ammunition or data.onset %} • {% endif %}{{'Item.CraftRequirements'|l}}: {{data.craftRequirements}}{% endif %}{% else %}{{'Common.None'|l}}{% endif %}",
          "form": {
            "title": "Item.AdditionalDetails",
            "sections": [
              {
                "type": "group",
                "fields": [
                  {
                    "title": "Item.Ammunition",
                    "attribute": "data.ammunition"
                  },
                  {
                    "title": "Item.Onset",
                    "attribute": "data.onset"
                  }
                ]
              },
              {
                "title": "Item.CraftRequirements",
                "type": "group",
                "fields": [
                  {
                    "title": "Item.CraftRequirements",
                    "type": "textArea",
                    "attribute": "data.craftRequirements"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "title": "ItemCategory.Armor",
      "type": "group",
      "visibleIf": "{% if data.category == 'armor' or data.dexCap != nil or data.checkPenalty != nil or data.str != nil or data.armorCategory or data.armorGroup %}true{% elif data.category != 'shield' %}{% if data.ac != nil or data.speedPenalty != nil %}true{% endif %}{% endif %}",
      "fields": [
        {
          "title": "Item.AcBonus",
          "type": "number",
          "attribute": "data.ac"
        },
        {
          "title": "Item.DexCap",
          "type": "number",
          "attribute": "data.dexCap"
        },
        {
          "title": "Item.CheckPenalty",
          "type": "number",
          "attribute": "data.checkPenalty"
        },
        {
          "title": "Item.SpeedPenalty",
          "type": "decimal",
          "attribute": "data.speedPenalty"
        },
        {
          "title": "Attribute.Strength",
          "type": "number",
          "attribute": "data.str"
        },
        {
          "title": "Item.ArmorCategory",
          "type": "picker",
          "attribute": "data.armorCategory",
          "attributeType": "ArmorCategory"
        },
        {
          "title": "Item.ArmorGroup",
          "type": "picker",
          "attribute": "data.armorGroup",
          "attributeType": "ArmorGroup"
        }
      ]
    },
    {
      "title": "ItemCategory.Shield",
      "type": "group",
      "visibleIf": "{% if data.category == 'shield' or data.hardness != nil or data.hp != nil or data.bt != nil %}true{% endif %}",
      "fields": [
        {
          "title": "Item.AcBonus",
          "type": "number",
          "attribute": "data.ac"
        },
        {
          "title": "Item.SpeedPenalty",
          "type": "decimal",
          "attribute": "data.speedPenalty"
        },
        {
          "title": "Item.Hardness",
          "type": "number",
          "attribute": "data.hardness"
        },
        {
          "title": "Common.HP",
          "type": "number",
          "attribute": "data.hp"
        },
        {
          "title": "Item.BT",
          "type": "number",
          "attribute": "data.bt"
        }
      ]
    },
    {
      "title": "ItemCategory.Weapon",
      "type": "group",
      "visibleIf": "{% if data.category == 'weapon' or data.damage or data.range != nil or data.reload or data.weaponType or data.weaponCategory or data.weaponGroup %}true{% endif %}",
      "fields": [
        {
          "title": "Common.Damage",
          "attribute": "data.damage"
        },
        {
          "title": "Common.Range",
          "type": "number",
          "attribute": "data.range"
        },
        {
          "title": "Item.Reload",
          "attribute": "data.reload"
        },
        {
          "title": "Item.Hands",
          "attribute": "data.hands"
        },
        {
          "title": "Item.WeaponType",
          "type": "picker",
          "attribute": "data.weaponType",
          "attributeType": "WeaponType"
        },
        {
          "title": "Item.WeaponCategory",
          "type": "picker",
          "attribute": "data.weaponCategory",
          "attributeType": "WeaponCategory"
        },
        {
          "title": "Item.WeaponGroup",
          "type": "picker",
          "attribute": "data.weaponGroup",
          "attributeType": "WeaponGroup"
        }
      ]
    },
    {
      "title": "ItemCategory.AdventuringGear",
      "type": "group",
      "visibleIf": "{% if data.category == 'adventuringGear' %}true{% elif data.category != 'weapon' and data.hands %}true{% endif %}",
      "fields": [
        {
          "title": "Item.Hands",
          "attribute": "data.hands"
        }
      ]
    },
    {
      "title": "Common.Description",
      "type": "group",
      "fields": [
        {
          "type": "textArea",
          "attribute": "descr"
        }
      ]
    },
    {
      "title": "Item.ActivationSettings",
      "type": "group",
      "fields": [
        {
          "title": "Item.PrimaryActivation",
          "type": "form",
          "text": "{% if data.activation.actions or data.activation.type or data.activation.traits or data.activation.text %}{% if data.activation.actions %}{{data.activation.actions|map: 'Action'}}{% endif %}{% if data.activation.type %}{% if data.activation.actions %} • {% endif %}{{data.activation.type}}{% endif %}{% if data.activation.traits %}{% if data.activation.actions or data.activation.type %} • {% endif %}{{data.activation.traits|map: 'Trait'}}{% endif %}{% if data.activation.text %}{% if data.activation.actions or data.activation.type or data.activation.traits %} • {% endif %}{{data.activation.text}}{% endif %}{% else %}{{'Common.None'|l}}{% endif %}",
          "form": {
            "sections": [
              {
                "type": "group",
                "fields": [
                  {
                    "title": "Common.Actions",
                    "type": "picker",
                    "attribute": "data.activation.actions",
                    "attributeType": "Action"
                  },
                  {
                    "title": "Common.Type",
                    "attribute": "data.activation.type",
                    "attributeType": "ItemActivationType"
                  },
                  {
                    "title": "Common.Traits",
                    "type": "tags",
                    "attribute": "data.activation.traits",
                    "attributeType": "Trait"
                  }
                ]
              },
              {
                "title": "Common.Description",
                "type": "group",
                "fields": [
                  {
                    "title": "Common.Description",
                    "type": "textArea",
                    "attribute": "data.activation.text"
                  }
                ]
              }
            ],
            "title": "Item.PrimaryActivation"
          },
          "detail": "Item.PrimaryActivationHelp"
        }
      ]
    },
    {
      "title": "Item.AdditionalActivations",
      "type": "list",
      "attribute": "data.activations",
      "form": {
        "title": "Item.NamedActivation",
        "partial": "ability"
      }
    },
    {
      "title": "Item.Variants",
      "type": "list",
      "attribute": "data.types",
      "form": {
        "title": "Item.Variant",
        "partial": "item-type"
      }
    }
  ]
}
